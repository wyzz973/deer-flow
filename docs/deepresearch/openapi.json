  "components": {
    "schemas": {
      "ConversationMessage": {
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 1,
            "title": "Text"
          },
          "client_message_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
            "title": "Client Message Id"
          },
          "plan_version": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Plan Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "text",
          "client_message_id"
        ],
        "title": "ConversationMessage"
      },
      "CreateResearch": {
        "properties": {
          "query": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 3,
            "title": "Query"
          },
          "constraints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Constraints"
          },
          "source_names": {
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Source Names"
          },
          "budget": {
            "$ref": "#/components/schemas/ResearchBudget"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "query"
        ],
        "title": "CreateResearch"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PlanDecision": {
        "properties": {
          "plan_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Plan Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "plan_version"
        ],
        "title": "PlanDecision"
      },
      "PlanEdit": {
        "properties": {
          "plan_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Plan Version"
          },
          "plan": {
            "$ref": "#/components/schemas/ResearchPlan"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "plan_version",
          "plan"
        ],
        "title": "PlanEdit"
      },
      "ResearchBudget": {
        "properties": {
          "max_iterations": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 0.0,
            "title": "Max Iterations",
            "default": 2
          },
          "max_units": {
            "type": "integer",
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Max Units",
            "default": 12
          },
          "max_tool_calls": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1000.0,
                "minimum": 2.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Tool Calls",
            "default": 60
          },
          "max_elapsed_seconds": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 14400.0,
                "minimum": 10.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Elapsed Seconds",
            "default": 900
          },
          "max_model_tokens": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2000000.0,
                "minimum": 1000.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Max Model Tokens",
            "default": 120000
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "ResearchBudget"
      },
      "ResearchPlan": {
        "properties": {
          "goal": {
            "type": "string",
            "maxLength": 12000,
            "minLength": 3,
            "title": "Goal"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "title": "Title",
            "default": ""
          },
          "brief": {
            "type": "string",
            "maxLength": 12000,
            "title": "Brief",
            "default": ""
          },
          "research_units": {
            "items": {
              "$ref": "#/components/schemas/ResearchUnit"
            },
            "type": "array",
            "maxItems": 64,
            "minItems": 1,
            "title": "Research Units"
          },
          "constraints": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 30,
            "title": "Constraints"
          },
          "assumptions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 10,
            "title": "Assumptions"
          },
          "expected_output": {
            "type": "string",
            "title": "Expected Output",
            "default": "有证据支撑的结构化研究报告"
          },
          "plan_version": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Plan Version",
            "default": 1
          },
          "clarification_questions": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 3,
            "title": "Clarification Questions"
          },
          "acknowledgement": {
            "type": "string",
            "maxLength": 1000,
            "title": "Acknowledgement",
            "default": ""
          },
          "source_policy": {
            "$ref": "#/components/schemas/SourcePolicy"
          },
          "report_style": {
            "type": "string",
            "enum": [
              "brief",
              "standard",
              "detailed"
            ],
            "title": "Report Style",
            "default": "standard"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "goal",
          "research_units"
        ],
        "title": "ResearchPlan"
      },
      "ResearchUnit": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
            "title": "Id"
          },
          "skill": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$",
            "title": "Skill"
          },
          "title": {
            "type": "string",
            "maxLength": 80,
            "title": "Title",
            "default": ""
          },
          "objective": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 3,
            "title": "Objective"
          },
          "priority": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 0.0,
            "title": "Priority",
            "default": 10
          },
          "source_strategy": {
            "$ref": "#/components/schemas/SourceStrategy"
          },
          "depends_on": {
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "type": "array",
            "maxItems": 64,
            "title": "Depends On"
          },
          "parent_gap_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Parent Gap Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "id",
          "skill",
          "objective"
        ],
        "title": "ResearchUnit"
      },
      "RetryResearch": {
        "properties": {
          "allow_limited_report": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Allow Limited Report"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "RetryResearch"
      },
      "SourcePolicy": {
        "properties": {
          "allowed_domains": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Allowed Domains"
          },
          "excluded_url_prefixes": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Excluded Url Prefixes"
          },
          "require_original": {
            "type": "boolean",
            "title": "Require Original",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SourcePolicy",
        "description": "Intent-derived citation scope, not a schema imposed on MCP results."
      },
      "SourceStrategy": {
        "properties": {
          "source_names": {
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,79}$"
            },
            "type": "array",
            "maxItems": 50,
            "title": "Source Names"
          },
          "required_origins": {
            "items": {
              "type": "string",
              "enum": [
                "internal",
                "external"
              ]
            },
            "type": "array",
            "minItems": 1,
            "title": "Required Origins"
          },
          "max_results": {
            "type": "integer",
            "maximum": 50.0,
            "minimum": 1.0,
            "title": "Max Results",
            "default": 12
          },
          "not_before": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Not Before"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SourceStrategy"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}

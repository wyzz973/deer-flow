{
  "mcpServers": {
    "your-internal-mcp": {
      "enabled": true,
      "type": "http",
      "url": "https://YOUR-INTERNAL-MCP/mcp",
      "headers_from_context": {
        "enabled": true,
        "headers": {"Cookie": "research_cookie", "X-Csrf-Token": "research_csrf"},
        "on_missing": "deny"
      }
    },
    "your-external-mcp": {
      "enabled": true,
      "type": "http",
      "url": "https://YOUR-EXTERNAL-MCP/mcp",
      "headers_from_context": {
        "enabled": true,
        "headers": {"Cookie": "research_cookie", "X-Csrf-Token": "research_csrf"},
        "on_missing": "deny"
      }
    }
  }
}
